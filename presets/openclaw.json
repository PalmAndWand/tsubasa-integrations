{
  "agents": {
    "defaults": {
      "models": {
        "tsubasa/tsubasa-fast": {
          "params": {
            "maxTokens": 4096
          }
        },
        "tsubasa/tsubasa-pro": {
          "params": {
            "maxTokens": 4096
          }
        }
      }
    }
  },
  "models": {
    "mode": "merge",
    "providers": {
      "tsubasa": {
        "baseUrl": "https://api.tsubasa.sh/v1",
        "apiKey": "${TSUBASA_API_KEY}",
        "api": "openai-completions",
        "models": [
          {
            "id": "tsubasa-fast",
            "name": "Tsubasa Fast",
            "reasoning": false,
            "input": [
              "text"
            ],
            "cost": {
              "input": 0.2,
              "output": 1,
              "cacheRead": 0,
              "cacheWrite": 0
            },
            "contextWindow": 32768,
            "maxTokens": 8192,
            "compat": {
              "supportsStore": false,
              "supportsDeveloperRole": false,
              "supportsReasoningEffort": false,
              "supportsLongCacheRetention": false,
              "supportsPromptCacheKey": false,
              "supportsTools": false,
              "supportsStrictMode": false,
              "supportsJsonSchemaResponseFormat": false,
              "maxTokensField": "max_tokens"
            }
          },
          {
            "id": "tsubasa-pro",
            "name": "Tsubasa Pro",
            "reasoning": false,
            "input": [
              "text"
            ],
            "cost": {
              "input": 0.5,
              "output": 4,
              "cacheRead": 0,
              "cacheWrite": 0
            },
            "contextWindow": 32768,
            "maxTokens": 16384,
            "compat": {
              "supportsStore": false,
              "supportsDeveloperRole": false,
              "supportsReasoningEffort": false,
              "supportsLongCacheRetention": false,
              "supportsPromptCacheKey": false,
              "supportsTools": false,
              "supportsStrictMode": false,
              "supportsJsonSchemaResponseFormat": false,
              "maxTokensField": "max_tokens"
            }
          }
        ]
      }
    }
  }
}
