{
  "providers": {
    "tsubasa": {
      "displayName": "Tsubasa",
      "apiKey": "${TSUBASA_API_KEY}",
      "apiBase": "https://api.tsubasa.sh/v1"
    }
  },
  "modelPresets": {
    "Tsubasa Fast": {
      "provider": "tsubasa",
      "model": "tsubasa-fast",
      "maxTokens": 8192,
      "contextWindowTokens": 32768,
      "temperature": 0.1
    },
    "Tsubasa Pro": {
      "provider": "tsubasa",
      "model": "tsubasa-pro",
      "maxTokens": 16384,
      "contextWindowTokens": 32768,
      "temperature": 0.1
    }
  },
  "agents": {
    "defaults": {
      "modelPreset": "Tsubasa Pro"
    }
  }
}
